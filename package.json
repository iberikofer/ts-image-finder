{
  "name": "js-image-finder",
  "version": "2.0.0",
  "description": "Modern responsive image finder web application powered by Pixabay API, SimpleLightbox, and Notiflix.",
  "homepage": "https://github.com/iberikofer/js-image-finder",
  "scripts": {
    "start": "parcel src/*.html",
    "build": "parcel build src/*.html --public-url /js-image-finder/",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iberikofer/js-image-finder.git"
  },
  "keywords": [
    "pixabay",
    "image-search",
    "simplelightbox",
    "notiflix",
    "parcel",
    "scss",
    "typescript"
  ],
  "author": "Yaroslav Sych <sych521@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iberikofer/js-image-finder/issues"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "modern-normalize": "^3.0.1",
    "notiflix": "^3.2.8",
    "simplelightbox": "^2.14.3"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "@types/node": "^26.6.5",
    "parcel": "^2.16.4",
    "parcel-reporter-clean-dist": "^1.0.4",
    "typescript": "^7.0.2"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead"
}
